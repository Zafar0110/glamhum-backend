 
NODE_ENV=development
PORT=5000
API_PREFIX=/api

 
CLIENT_URL=http://localhost:3000

 
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=glamhub
DB_CONNECTION_LIMIT=10

 
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
JWT_REMEMBER_ME_EXPIRES_IN=30d
BCRYPT_ROUNDS=10

 # Uploads (portfolio images / avatars)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=15

# OTP
OTP_LENGTH=4
OTP_EXPIRES_MINUTES=10
# In development the generated OTP is returned in the API response so you can
# test without an SMS/email provider. Never enable this in production.
OTP_DEBUG_RETURN=true

# Stripe (leave empty until you wire real keys)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PLATFORM_COMMISSION_PERCENT=10


SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=GlamHub <no-reply@yourdomain.com>


PUBLIC_URL=http://localhost:5000


OTP_CHANNEL=phone
OTP_PHONE_LENGTH=6
OTP_EMAIL_LENGTH=4
# Account SID (AC…) is ALWAYS required — it identifies the account.
TWILIO_ACCOUNT_SID=

# Authenticate with EITHER an API key (recommended, revocable on its own)…
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# …OR the account auth token.
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
# Twilio Verify service SID (VA…) — needed for UAE delivery.
TWILIO_VERIFY_SERVICE_SID=
