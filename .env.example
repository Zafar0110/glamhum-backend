# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
API_PREFIX=/api

# Frontend origin(s) allowed by CORS (comma separated)
CLIENT_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# MySQL
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=glamhub
DB_CONNECTION_LIMIT=10

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
JWT_REMEMBER_ME_EXPIRES_IN=30d
BCRYPT_ROUNDS=10

# ---------------------------------------------------------------------------
# Uploads (portfolio images / avatars)
# ---------------------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=15

# ---------------------------------------------------------------------------
# OTP
# ---------------------------------------------------------------------------
OTP_LENGTH=4
OTP_EXPIRES_MINUTES=10
# In development the generated OTP is returned in the API response so you can
# test without an SMS/email provider. Never enable this in production.
OTP_DEBUG_RETURN=true

# ---------------------------------------------------------------------------
# Stripe (leave empty until you wire real keys)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PLATFORM_COMMISSION_PERCENT=10

# ---------------------------------------------------------------------------
# Email / SMTP (OTP delivery)
# Leave SMTP_HOST empty in local dev: codes are printed to the console and
# returned as `debugCode` while OTP_DEBUG_RETURN=true.
# On cPanel use your mail host, port 465 + SMTP_SECURE=true (or 587 + false).
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=GlamHub <no-reply@yourdomain.com>

# ---------------------------------------------------------------------------
# Public origin of THIS API. Stored upload paths are returned as absolute URLs
# against it, so the frontend renders images without knowing where they live.
# On cPanel set this to your real API domain, e.g. https://api.yourdomain.com
# ---------------------------------------------------------------------------
PUBLIC_URL=http://localhost:5000
